 "fields": [
  {
   "fieldname": "section_search",
   "fieldtype": "Section Break",
   "label": "Search"
  },
  {
   "default": "0",
   "fieldname": "show_page_search",
   "fieldtype": "Check",
   "label": "Search Box in Page Header",
   "description": "A search box in the middle of every page's header: it opens Frappe's Global Search (Ctrl+G) with what was typed, on the page's DocType when Global Search has it. Shows after the page is reloaded."
  },
  {
   "default": "0",
   "fieldname": "search_inside_words",
   "fieldtype": "Check",
   "label": "Search Inside Words",
   "description": "Global Search finds whole words (00002676, not 2676). Ticked: when it finds few, it also finds the documents that have the text anywhere in what Global Search keeps of them, as the user may read them."
  },
  {
   "fieldname": "section_raven",
   "fieldtype": "Section Break",
   "label": "Raven Chat"
  },
  {
   "default": "0",
   "fieldname": "enable_raven_chat_button",
   "fieldtype": "Check",
   "label": "Enable Floating Raven Chat Button"
  },
  {
   "fieldname": "notification_sound_type",
   "fieldtype": "Select",
   "label": "Chat Notification Sound",
   "options": "Raven Default\nDing\nChime\nPop\nBell\nTriple Beep\nSoft\nMarimba\nCustom",
   "default": "Raven Default",
   "depends_on": "eval:doc.enable_raven_chat_button"
  },
  {
   "fieldname": "notification_sound",
   "fieldtype": "Attach",
   "label": "Custom Sound File",
   "description": "mp3 / wav / ogg — short (1-2 sec)",
   "depends_on": "eval:doc.enable_raven_chat_button && doc.notification_sound_type=='Custom'"
  },
  {
   "fieldname": "notification_volume",
   "fieldtype": "Int",
   "label": "Notification Volume (0-100)",
   "default": "50",
   "depends_on": "eval:doc.enable_raven_chat_button"
  }
 ],
